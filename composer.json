{
    "name": "liquidlight/module-data-listing",
    "version": "2.0.0",
    "description": "Filterable, searchable and sortable datatables for the TYPO3 backend. Fe_users comes as default.",
    "license": "GPL-2.0+",
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3 CMS",
        "Backend",
        "Module",
        "fe_users",
        "Export"
    ],
    "readme": "./README.md",
    "authors": [
        {
            "name": "Liquid Light",
            "email": "info@liquidlight.co.uk",
            "homepage": "https://www.liquidlight.co.uk/"
        },
        {
            "name": "Mike Street",
            "email": "mike@liquidlight.co.uk"
        },
        {
            "name": "Garett Robson",
            "email": "garett@liquidlight.co.uk"
        }
    ],
    "homepage": "https://github.com/liquidlight/module_data_listing",
    "support": {
        "issues": "https://github.com/liquidlight/module_data_listing/issues",
        "source": "https://github.com/liquidlight/module_data_listing"
    },
    "require": {
        "typo3/cms-backend": "^12.4",
        "typo3/cms-core": "^12.4",
        "typo3/cms-extbase": "^12.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "typo3/testing-framework": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "LiquidLight\\ModuleDataListing\\": "Classes"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "module_data_listing",
            "web-dir": ".Build/public"
        }
    },
    "scripts": {
        "prepare-release": [
            "rm -rf .github",
            "rm .gitignore",
            "rm .project.php_cs",
            "rm -rf Tests",
            "rm phpunit.xml"
        ],
        "lint": [
            "@lint:php"
        ],
        "lint:php": [
            "php-cs-fixer fix . --config=.project.php_cs"
        ],
        "clean": "rm -rf .Build",
        "test-unit": "phpunit --no-coverage --testsuite=\"Unit tests\""
    },
    "autoload-dev": {
        "psr-4": {
            "LiquidLight\\ModuleDataListing\\Tests\\": "Tests"
        }
    },
    "config": {
        "lock": false,
        "vendor-dir": ".Build/vendor",
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        }
    }
}
